<?xml version="1.0" encoding="utf-8"?>
<!-- Splash de Android 11 o menos: fondo crema y el logo de Wawa Qhali al centro.
     En Android 12+ el splash se define en values-v31/styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/wawa_crema" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash" />
    </item>
</layer-list>
