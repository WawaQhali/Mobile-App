<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash de Android 12+: el sistema lo dibuja con estos valores. Sin esto usa el
         ícono de la app sobre el fondo del tema (por eso salía el logo de Flutter). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/wawa_crema</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/wawa_crema</item>
    </style>
</resources>
